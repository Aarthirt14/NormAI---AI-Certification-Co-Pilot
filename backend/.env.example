# NormAI Backend — Environment Variables
# Copy this to .env and fill in values before running

# === DATABASE ===
# Local PostgreSQL on port 5433 (trust auth, no password needed)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/normai

# === JWT / AUTH ===
JWT_SECRET=normai-sih-2026-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === LLM — Google Gemini ===
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# === EMBEDDINGS ===
# Uses Gemini embedding API (same key)
EMBEDDING_MODEL=models/text-embedding-004

# === FILE UPLOADS ===
UPLOAD_DIRECTORY=./storage/uploads
GENERATED_DIRECTORY=./storage/generated
MAX_UPLOAD_SIZE_MB=25

# === FRONTEND ===
FRONTEND_ORIGIN=http://localhost:3000

# === SERVER ===
HOST=127.0.0.1
PORT=8000
DEBUG=true
